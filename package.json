{
  "name": "glass",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "crates/*",
    "crates/skillset/skillset"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "generate-plugin": "bun run --filter @glass/skillset generate-plugin",
    "check-plugin": "bun run --filter @glass/skillset check",
    "check": "bun run lint && turbo run build typecheck test check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
