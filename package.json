{
  "name": "glass",
  "private": true,
  "type": "module",
  "description": "Glass skills and tooling monorepo",
  "repository": {
    "type": "git",
    "url": "https://github.com/intuscare/glass"
  },
  "license": "MIT",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts",
    "skills"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "turbo run test",
    "check": "bun run lint && turbo run build typecheck test check",
    "changeset": "bun node_modules/.bin/changeset",
    "version": "bun run changeset version && bun scripts/sync-plugin-version.mjs",
    "check-plugin-version": "bun scripts/sync-plugin-version.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0",
    "turbo": "2.11.5",
    "typescript": "7.0.2"
  }
}
