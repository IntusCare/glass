{
  "name": "@glass/skillset",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "skillset+extract": "skillset/extract-skills.ts",
    "skillset+index": "skillset/index-skills.ts"
  },
  "description": "Indexes the skills in every suite under crates/skillset into skills.csv",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "QUIET=true bun test skillset/*.test.ts",
    "check": "bun skillset/index-skills.ts --check && bun skillset/extract-skills.ts --check",
    "extract-skills": "bun skillset/extract-skills.ts",
    "index-skills": "bun skillset/index-skills.ts"
  },
  "dependencies": {
    "@glass/scripts": "workspace:*",
    "papaparse": "5.5.3",
    "zx": "8.8.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "22.20.4",
    "@types/papaparse": "5.3.16"
  }
}
