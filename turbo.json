{
  "$schema": "./node_modules/turbo/schema.json",
  "globalDependencies": [
    "tsconfig.json",
    "biome.json",
    "bunfig.toml",
    "mise.toml"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "//#test": {
      "outputs": []
    }
  }
}
