{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!crates/skillset/gstack",
      "!!crates/skillset/mattpocock",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/.turbo",
      "!!**/coverage"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "overrides": [
    {
      "includes": [
        ".claude-plugin/*.json",
        ".devin-plugin/*.json",
        ".codex-plugin/*.json",
        ".agents/plugins/marketplace.json"
      ],
      "json": {
        "formatter": {
          "expand": "always"
        }
      }
    }
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
