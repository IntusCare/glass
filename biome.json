{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "package.json",
      "turbo.json",
      "tsconfig.json",
      "biome.json",
      "scripts/**",
      "crates/skillset/package.json",
      "crates/skillset/tsconfig.json",
      "crates/skillset/skillset/*.ts",
      "apps/**",
      "packages/**",
      "!!**/dist",
      "!!**/node_modules",
      "!!**/.turbo"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
